# PUBLIC app-build configuration only. Every value is compiled into the app.
# Never add a Supabase service-role key, client secret, signing key, age private
# key, database URL, or authenticated OTLP header here.
HHM_API_BASE_URL=https://api.hhm.example
HHM_SHARED_AUTH_ISSUER=https://auth.hhm.example
HHM_SUPABASE_URL=https://project-ref.supabase.co
HHM_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
HHM_OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.hhm.example/v1/traces
HHM_RELEASE_ENVIRONMENT=development
